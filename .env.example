TALENTMATCH_LLM_PROVIDER=ollama
TALENTMATCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
TALENTMATCH_CHAT_MODEL=qwen2.5:7b
TALENTMATCH_EMBED_MODEL=embeddinggemma
TALENTMATCH_OLLAMA_WORKERS=2
TALENTMATCH_AUTH_SESSION_HOURS=8
TALENTMATCH_TASK_BACKEND=memory
TALENTMATCH_REDIS_PASSWORD=change-me-before-deployment
TALENTMATCH_REDIS_URL=redis://:change-me-before-deployment@127.0.0.1:6379/0
TALENTMATCH_TASK_QUEUE=talentmatch
TALENTMATCH_TASK_RESULT_TTL=86400
TALENTMATCH_DATABASE_PATH=data/talentmatch.db
# PostgreSQL部署时设置：postgresql+psycopg://user:password@host:5432/talentmatch
TALENTMATCH_DATABASE_URL=
TALENTMATCH_ALLOW_ORIGINS=http://localhost:5173
TALENTMATCH_POSTGRES_PASSWORD=change-me-before-deployment
TALENTMATCH_HTTP_PORT=8080
